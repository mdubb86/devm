# Managed by devm. Regenerated on VM lifecycle events; hand edits will be
# overwritten. If you need to re-add the Include, put it NEAR THE TOP of
# ~/.ssh/config — before any Host or Match block — otherwise ssh_config
# scoping ties the Include to the preceding block and devm's Host entries
# won't resolve.
#     Include "{{RUNTIME_DIR}}/ssh_config"

Host devm-myproj
    HostName             myproj.test
    User                 devm
    Port                 22
    IdentityFile         "{{RUNTIME_DIR}}/ssh/projects/myproj/id_ed25519"
    UserKnownHostsFile   "{{RUNTIME_DIR}}/ssh/projects/myproj/known_hosts"
    HostKeyAlias         devm-myproj
    StrictHostKeyChecking yes
    IdentitiesOnly       yes

