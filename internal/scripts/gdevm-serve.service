[Unit]
Description=devm guest-side state daemon
After=network.target

[Service]
Type=simple
Environment=DEVM_TLD={{.TLD}}
ExecStart=/usr/local/bin/gdevm serve
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
# KillMode=process is deliberate (systemd calls it "not recommended",
# but that caveat is for the general case of leaked children). We
# want those children to survive: `gdevm run -d <name>` detached
# services keep running across `systemctl restart gdevm-serve` and
# across a crash restart. On the next boot gdevm serve walks
# /var/log/gdevm/*.state, checks each pgroup with Kill(pgid, 0),
# and rediscovers the live ones so `gdevm runs` / `gdevm stop` see
# them again. `KillMode=mixed` would SIGKILL every bash child in the
# cgroup after the main process exits — which would make rediscovery
# meaningless.
KillMode=process
# Create /var/log/gdevm with correct permissions. Each run writes
# its merged stdout+stderr here; `gdevm logs <name>` serves these
# files back.
LogsDirectory=gdevm
LogsDirectoryMode=0755

[Install]
WantedBy=multi-user.target
